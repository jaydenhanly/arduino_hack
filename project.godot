; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="retro-ai"
config/version="0.2"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
run/max_fps=60

[autoload]

LightSensor="*res://scripts/light_sensor.gd"

[display]

window/size/viewport_width=400
window/size/viewport_height=240
window/size/resizable=false
window/size/window_width_override=800
window/size/window_height_override=480
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="retro-ai"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.608, 0.737, 0.059, 1)
